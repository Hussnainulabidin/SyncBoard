{
  "name": "SyncBoard - Meeting to Trello Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "process-meeting",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "syncboard-meeting"
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ $json.audioFile }}"
            },
            {
              "name": "model",
              "value": "whisper-1"
            },
            {
              "name": "response_format",
              "value": "verbose_json"
            }
          ]
        },
        "options": {}
      },
      "id": "whisper-transcribe",
      "name": "Whisper Transcription",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [470, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-creds",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "content": "You are an expert meeting analyst. Extract all action items from the transcript. For each item, provide: task (brief title), description, assignee (if mentioned), deadline (if mentioned), priority (high/medium/low), and labels. Return as JSON array.",
              "role": "system"
            },
            {
              "content": "=Meeting Transcript:\n\n{{ $json.text }}\n\nExtract all action items as a JSON object with 'action_items' array.",
              "role": "user"
            }
          ]
        },
        "jsonOutput": true,
        "options": {
          "temperature": 0.3
        }
      },
      "id": "gpt-extract",
      "name": "GPT-4 Extract Actions",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.2,
      "position": [690, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-creds",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = JSON.parse($input.first().json.message.content);\nconst actionItems = response.action_items || [];\n\n// Parse deadlines to ISO dates\nconst parseDeadline = (deadline) => {\n  if (!deadline) return null;\n  const today = new Date();\n  const lower = deadline.toLowerCase();\n  \n  const days = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];\n  for (let i = 0; i < days.length; i++) {\n    if (lower.includes(days[i])) {\n      const daysUntil = (i - today.getDay() + 7) % 7 || 7;\n      const target = new Date(today);\n      target.setDate(today.getDate() + daysUntil);\n      return target.toISOString().split('T')[0];\n    }\n  }\n  \n  if (lower.includes('tomorrow')) {\n    const tomorrow = new Date(today);\n    tomorrow.setDate(today.getDate() + 1);\n    return tomorrow.toISOString().split('T')[0];\n  }\n  \n  return null;\n};\n\nreturn actionItems.map((item, index) => ({\n  json: {\n    id: `ticket-${Date.now()}-${index}`,\n    name: item.task || item.title,\n    desc: item.description || '',\n    assignee: item.assignee || null,\n    due: parseDeadline(item.deadline),\n    priority: item.priority || 'medium',\n    labels: item.labels || []\n  }\n}));"
      },
      "id": "transform-tickets",
      "name": "Transform to Tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "resource": "card",
        "operation": "create",
        "idList": "={{ $env.TRELLO_LIST_ID }}",
        "name": "={{ $json.name }}",
        "description": "={{ $json.desc }}\n\n---\nGenerated by SyncBoard",
        "additionalFields": {
          "due": "={{ $json.due }}"
        }
      },
      "id": "trello-create",
      "name": "Create Trello Card",
      "type": "n8n-nodes-base.trello",
      "typeVersion": 1,
      "position": [1130, 300],
      "credentials": {
        "trelloApi": {
          "id": "trello-creds",
          "name": "Trello API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, cardsCreated: $items().length, cards: $items().map(i => ({ id: i.json.id, name: i.json.name })) } }}"
      },
      "id": "respond",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1350, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Whisper Transcription",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Whisper Transcription": {
      "main": [
        [
          {
            "node": "GPT-4 Extract Actions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GPT-4 Extract Actions": {
      "main": [
        [
          {
            "node": "Transform to Tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform to Tickets": {
      "main": [
        [
          {
            "node": "Create Trello Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Trello Card": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "SyncBoard",
      "createdAt": "2026-04-01T00:00:00.000Z"
    }
  ],
  "meta": {
    "instanceId": "syncboard-mvp"
  }
}
