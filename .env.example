# SyncBoard MVP - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# OpenAI Configuration (Required)
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# AssemblyAI Configuration (Optional)
# ===========================================
# For speaker diarization (who said what)
# Get your API key from: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your-assemblyai-key-here

# ===========================================
# Trello Configuration (Required for publishing)
# ===========================================
# Step 1: Get API Key from https://trello.com/power-ups/admin
TRELLO_API_KEY=your-trello-api-key

# Step 2: Generate Token by visiting:
# https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_API_KEY
TRELLO_TOKEN=your-trello-token

# Step 3: Get Board ID from any Trello board URL
# URL format: https://trello.com/b/BOARD_ID/board-name
TRELLO_BOARD_ID=your-default-board-id

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# Frontend Configuration (Optional)
# ===========================================
REACT_APP_API_URL=http://localhost:3001/api
