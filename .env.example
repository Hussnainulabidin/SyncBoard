# SyncBoard MVP - Environment Configuration
# Copy this file to backend/.env and fill in your values

# ===========================================
# Azure OpenAI - Whisper (Transcription)
# ===========================================
# Get from: Azure Portal > Your AI resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.services.ai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper-1

# ===========================================
# Groq API - Ticket Analysis (Free Tier)
# ===========================================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ===========================================
# AssemblyAI - Speaker Diarization (Optional)
# ===========================================
# Enables "who said what" speaker labels in transcripts
# Get from: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# ===========================================
# Trello (Required for publishing)
# ===========================================
# Step 1: Get API Key from https://trello.com/power-ups/admin
TRELLO_API_KEY=your-trello-api-key

# Step 2: Generate Token by visiting:
# https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=YOUR_API_KEY
TRELLO_TOKEN=your-trello-token

# ===========================================
# Server
# ===========================================
PORT=3001
NODE_ENV=development
REACT_APP_API_URL=http://localhost:3001/api
